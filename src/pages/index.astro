---
import templateData from "../data/templates.json";
import "../styles/shell.css";
const templates = templateData.templates.filter((template) => template.listed);
const siteUrl = "https://ofs-demos.endian.dev";
const pageTitle = "Websites for Secular Franciscan Fraternities";
const pageDescription = "A welcoming website for your Secular Franciscan fraternity. Explore five complete designs, picture your community, and find what feels right.";
const contactEmail = "bill@endian.dev";
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const ogImage = `${siteUrl}/thumbs/${templates[0].thumb}`;
const structuredData = {
  "@context": "https://schema.org", "@type": "ProfessionalService",
  name: pageTitle, description: pageDescription, url: `${siteUrl}/`,
  email: contactEmail, image: ogImage,
  serviceType: "Website design and development for Secular Franciscan fraternities"
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fraternity websites" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#designs">Skip to designs</a>
    <header class="site-header page-width"><a class="site-brand" href="/">Fraternity websites</a><a class="header-cta" href="#contact">Get in touch <span aria-hidden="true">↓</span></a></header>
    <main class="page-width">
      <section class="gallery-intro" aria-labelledby="page-heading">
        <h1 id="page-heading">A welcoming website for your fraternity.</h1>
        <p>Five different starting points for Secular Franciscan communities. Explore a design, picture your fraternity, and find what feels right.</p>
      </section>
      <section id="designs" aria-label="Website designs">
        <div class="design-grid">
          {templates.map((template, index) => (
            <a class="design-card" id={`design-${index + 1}`} href={`/preview?d=${template.slug}`} aria-label={`Preview ${template.title}`}>
              <div class="design-thumb"><img src={`/thumbs/${template.thumb}`} alt={`${template.title} homepage`} width="720" height="450" loading={index < 3 ? "eager" : "lazy"} decoding="async" /></div>
              <div class="design-card-copy"><h2>{template.title}</h2><p>{template.blurb}</p><span class="design-card-arrow" aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
        <p class="sample-note">Every design uses the fictional St. Clare Fraternity in Cedar Grove. Names, gatherings, and contact details are examples; demo forms don’t send messages.</p>
      </section>
      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="contact-intro"><p class="eyebrow">LET’S TALK</p><h2 id="contact-heading">Let’s make one your own.</h2><p>Tell me about your fraternity, the people you hope to reach, and what you’d like your website to do.</p><p>Prefer email? <a href="mailto:bill@endian.dev?subject=Fraternity%20website%20inquiry">bill@endian.dev</a></p></div>
        <form id="contact-form" action="/api/contact" method="post" data-turnstile-site-key={siteKey}>
          <p class="form-note">Name, email, and message are required.</p>
          <div class="form-pair">
            <label for="contact-name">Your name<input id="contact-name" name="name" autocomplete="name" maxlength="100" required /></label>
            <label for="contact-email">Email address<input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          </div>
          <div class="form-pair">
            <label for="contact-fraternity">Fraternity (optional)<input id="contact-fraternity" name="fraternity" autocomplete="organization" maxlength="160" /></label>
            <label for="contact-design">Design interest (optional)<select id="contact-design" name="design"><option value="">Still exploring</option>{templates.map((template) => <option value={template.title}>{template.title}</option>)}</select></label>
          </div>
          <label for="contact-message">Your message<textarea id="contact-message" name="message" rows="5" maxlength="5000" required></textarea></label>
          <div class="form-trap" aria-hidden="true"><label for="contact-website">Leave this field empty<input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div data-turnstile></div>
          <button class="send-button" type="submit" disabled>Send message</button>
          <p class="form-status" data-form-status role="status" aria-live="polite">{siteKey ? "Loading the spam check…" : "The form is not available yet. Please email bill@endian.dev."}</p>
          <noscript><p>Please email <a href="mailto:bill@endian.dev">bill@endian.dev</a> to get in touch.</p></noscript>
        </form>
      </section>
    </main>
    <script>import "../scripts/contact";</script>
  </body>
</html>
