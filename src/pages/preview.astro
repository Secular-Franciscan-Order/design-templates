---
import templateData from "../data/templates.json";
import "../styles/shell.css";
const firstTemplate = templateData.templates.find((template) => template.listed)!;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Explore a complete website design for your Secular Franciscan fraternity." />
    <title>Design preview · Fraternity websites</title>
  </head>
  <body class="preview-page">
    <header class="preview-toolbar" data-preview-toolbar>
      <a class="back-to-designs" href="/#designs">← Back to designs</a>
      <div class="preview-identity" aria-live="polite" aria-atomic="true">
        <h1 data-template-title tabindex="-1">{firstTemplate.title}</h1>
        <p data-design-number>Design 1 of 5</p>
      </div>
      <nav class="preview-steps" aria-label="Design navigation">
        <button type="button" data-previous disabled>← Previous</button>
        <button type="button" data-next>Next →</button>
      </nav>
    </header>
    <main class="preview-stage" data-frame-shell>
      <iframe data-preview-frame src={firstTemplate.src} title={`${firstTemplate.title} website design`} sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </main>
    <script id="template-data" type="application/json" is:inline set:html={JSON.stringify(templateData)}></script>
    <script>import "../scripts/preview";</script>
  </body>
</html>
